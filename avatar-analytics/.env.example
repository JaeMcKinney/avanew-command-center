# Browser settings. Copy to .env.local and fill in.
# For local development, `npx supabase status` prints these values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Only needed locally, where `npm run functions` serves the functions.
# Leave unset in production: the app then uses <VITE_SUPABASE_URL>/functions/v1.
VITE_FUNCTIONS_URL=http://127.0.0.1:54399/functions/v1
