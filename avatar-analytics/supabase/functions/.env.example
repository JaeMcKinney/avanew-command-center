# Server-side settings for the functions. Copy to supabase/functions/.env for
# local development. In production set these with `supabase secrets set`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by Supabase in production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tavus API key. Never put this in a VITE_ variable.
TAVUS_API_KEY=your-tavus-api-key
# Optional. Defaults to https://tavusapi.com/v2
# TAVUS_API_BASE=

# Anthropic API key, for conversation summaries and the questions list.
# Without it, transcripts still arrive but are not summarised.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Defaults to claude-haiku-5-5 (low cost). Use claude-sonnet-5-5 or claude-opus-5-5 for a larger model.
# INSIGHTS_MODEL=

# Where the app runs. Invite emails link back here.
APP_URL=http://127.0.0.1:5180
# Shared secret the schedule sends in the x-cron-secret header.
CRON_SECRET=choose-a-long-random-string
# Optional. Public address of the functions, if it differs from
# <SUPABASE_URL>/functions/v1 (used to build the webhook address given to Tavus).
# PUBLIC_FUNCTIONS_URL=

# Email, for "Email to me" on transcript exports (https://resend.com). Both are needed.
# RESEND_API_KEY=
# EMAIL_FROM=Divigner <reports@your-domain.com>

# Stripe (billing). Use test-mode keys until you are ready to charge real cards.
# STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint that points at <functions URL>/stripe-webhook.
# STRIPE_WEBHOOK_SECRET=

# Support desk email. Replies on a ticket are emailed with the two settings
# above. To let people answer those emails (and email new tickets in), set the
# support address and the signing secret of a Resend webhook for the
# "email.received" event that points at <functions URL>/support-inbound.
# SUPPORT_INBOUND_ADDRESS=support@your-receiving-domain.com
# RESEND_WEBHOOK_SECRET=
