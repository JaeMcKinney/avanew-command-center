# Server-side settings for the functions. Copy to supabase/functions/.env for
# local development. In production set these with `supabase secrets set`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by Supabase in production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tavus API key. Never put this in a VITE_ variable.
TAVUS_API_KEY=your-tavus-api-key
# Optional. Defaults to https://tavusapi.com/v2
# TAVUS_API_BASE=

# Where the app runs. Invite emails link back here.
APP_URL=http://127.0.0.1:5180
# Shared secret the schedule sends in the x-cron-secret header.
CRON_SECRET=choose-a-long-random-string
# Optional. Public address of the functions, if it differs from
# <SUPABASE_URL>/functions/v1 (used to build the webhook address given to Tavus).
# PUBLIC_FUNCTIONS_URL=
