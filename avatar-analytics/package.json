{
  "name": "avatar-analytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run functions:check",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,realtime,edge-runtime,supavisor",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/types/db.ts",
    "functions": "DENO_NO_PACKAGE_JSON=1 ANTHROPIC_BASE_URL=http://127.0.0.1:54398/anthropic GLASS_API_BASE=http://127.0.0.1:54398/glass deno run --allow-net --allow-env --env-file=supabase/functions/.env scripts/serve-functions.ts",
    "functions:check": "DENO_NO_PACKAGE_JSON=1 deno check scripts/serve-functions.ts supabase/functions/*/index.ts",
    "seed": "node scripts/seed-demo.mjs",
    "mock-tavus": "node tests/mock-tavus.mjs",
    "dev:shared": "SHARED_PREVIEW=1 VITE_SUPABASE_URL=/_sb VITE_FUNCTIONS_URL=/_fn/functions/v1 vite"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.73.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "deno": "^2.9.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "supabase": "^3.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
